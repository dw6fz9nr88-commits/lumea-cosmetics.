<title>LUMÉA — Skin, Naturally</title>
<style>
:root {
  --bg:#f8f6f0;
  --paper:#fffefa;
  --ink:#292c23;
  --muted:#77796e;
  --green:#68745a;
  --green-dark:#48533e;
  --line:#e5e3d9;
  --serif:Georgia,"Times New Roman",serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:Arial,Helvetica,sans-serif}
button,a{font:inherit}
a{color:inherit;text-decoration:none}
button{cursor:pointer}
.announcement{background:var(--green-dark);color:white;text-align:center;
  padding:10px 12px;font-size:11px;letter-spacing:1.3px}
header{background:var(--bg);position:sticky;top:0;z-index:10;
  border-bottom:1px solid var(--line)}
.nav{max-width:1240px;margin:auto;min-height:76px;padding:0 5%;
  display:flex;align-items:center;justify-content:space-between;gap:18px}
.logo{font-family:var(--serif);font-size:30px;letter-spacing:5px}
.logo small{display:block;font-family:Arial,sans-serif;font-size:8px;
  letter-spacing:4px;text-align:center;margin-top:2px}
.navlinks{display:flex;gap:27px;font-size:12px}
.navlinks a:hover{color:var(--green)}
.navright{display:flex;align-items:center;gap:12px}
.lang{border:0;background:transparent;color:var(--ink);font-size:11px}
.cart{border:1px solid var(--ink);background:transparent;padding:11px 14px;
  font-size:11px;white-space:nowrap}
.cart:hover{background:var(--ink);color:white}
.hero{max-width:1440px;margin:auto;padding:28px 4% 55px}
.hero-inner{display:grid;grid-template-columns:1fr 1fr;min-height:490px;
  background:#e8e8dc}
.hero-copy{padding:clamp(28px,6vw,76px);display:flex;flex-direction:column;
  justify-content:center;align-items:flex-start}
.eyebrow{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;
  color:var(--green);font-weight:bold}
h1{font-family:var(--serif);font-size:clamp(44px,6vw,76px);
  font-weight:400;line-height:1.02;letter-spacing:-2px;margin:22px 0}
h1 em{font-weight:400;color:var(--green)}
.hero-copy p{font-size:14px;color:#65675d;line-height:1.9;max-width:360px}
.btn{display:inline-block;background:var(--green-dark);color:white;
  border:1px solid var(--green-dark);padding:15px 23px;margin-top:22px;
  font-size:11px;letter-spacing:1px;text-transform:uppercase}
.btn:hover{background:var(--ink)}
.hero-image{min-height:400px;position:relative;overflow:hidden}
.hero-image img{width:100%;height:100%;position:absolute;inset:0;
  object-fit:cover;object-position:center}
.hero-note{position:absolute;bottom:20px;left:20px;background:#fffefaeb;
  padding:13px 17px;font-family:var(--serif);font-size:16px}
.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
  padding:27px 5%;border-bottom:1px solid var(--line);
  border-top:1px solid var(--line);text-align:center}
.benefits div{font-size:11px;letter-spacing:.5px}
.benefits span{display:block;color:var(--muted);font-size:10px;
  margin-top:7px;letter-spacing:0}
.section{max-width:1240px;margin:auto;padding:76px 5%}
.section-head{display:flex;justify-content:space-between;align-items:end;
  gap:20px;margin-bottom:30px}
h2{font-family:var(--serif);font-size:clamp(34px,4vw,48px);
  font-weight:400;letter-spacing:-1px;margin:12px 0}
.section-head p{font-size:12px;color:var(--muted);line-height:1.7;
  max-width:300px;margin:0 0 5px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:25px}
.filter{border:1px solid var(--line);background:transparent;padding:10px 15px;
  font-size:11px;color:var(--muted)}
.filter.active,.filter:hover{background:var(--green-dark);color:white;
  border-color:var(--green-dark)}
.products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}
.product{min-width:0}
.product-photo{position:relative;background:#eeece4;aspect-ratio:4/5;
  overflow:hidden}
.product-photo img{width:100%;height:100%;object-fit:cover;
  transition:transform .5s}
.product:hover .product-photo img{transform:scale(1.04)}
.tag{position:absolute;top:12px;left:12px;background:var(--paper);
  padding:7px 9px;font-size:9px;letter-spacing:.5px}
.quick-add{position:absolute;bottom:10px;left:10px;right:10px;width:calc(100% - 20px);
  border:0;background:#fffef2ed;color:var(--ink);padding:13px 5px;
  font-size:10px;letter-spacing:1px;text-transform:uppercase}
.quick-add:hover{background:var(--green-dark);color:white}
.product-info{padding:15px 1px}
.product-type{color:var(--muted);font-size:9px;letter-spacing:1.2px;
  text-transform:uppercase}
.product-title{font-family:var(--serif);font-size:18px;margin:7px 0}
.product-desc{color:var(--muted);font-size:11px;line-height:1.6;
  min-height:35px}
.price-row{display:flex;justify-content:space-between;align-items:center;
  gap:8px;margin-top:12px;font-size:13px}
.stars{font-size:10px;color:var(--green)}
.story{display:grid;grid-template-columns:1fr 1fr;background:#e9e8dd}
.story-image{min-height:400px}
.story-image img{width:100%;height:100%;object-fit:cover;display:block}
.story-copy{padding:clamp(30px,6vw,75px);display:flex;flex-direction:column;
  align-items:flex-start;justify-content:center}
.story-copy p{font-size:13px;line-height:1.9;color:#66685e;max-width:390px}
.quote{font-family:var(--serif);font-size:22px;line-height:1.5;
  margin-top:18px;color:var(--green-dark)}
.newsletter{text-align:center;background:#e9e8dd;padding:65px 20px}
.newsletter p{color:var(--muted);font-size:12px;line-height:1.8}
.newsletter-form{display:flex;max-width:420px;margin:25px auto 0}
.newsletter-form input{min-width:0;flex:1;border:1px solid #d4d4c8;
  background:#fffefa;padding:14px;font-size:12px}
.newsletter-form button{border:0;background:var(--green-dark);color:white;
  padding:0 17px;font-size:10px;letter-spacing:1px}
#newsletter-message{min-height:18px;font-size:11px}
footer{padding:35px 5%;background:#30362b;color:#f8f6f0}
.footer-inner{max-width:1240px;margin:auto;display:flex;justify-content:space-between;
  align-items:center;gap:25px;flex-wrap:wrap}
footer .logo{font-size:25px}
footer p{font-size:10px;color:#c7c9bd;line-height:1.8}
.footer-links{display:flex;gap:18px;font-size:11px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);
  background:var(--green-dark);color:white;padding:14px 20px;font-size:12px;
  z-index:30;box-shadow:0 5px 20px #0002;display:none;max-width:90vw;
  text-align:center}
.toast.show{display:block}
.cart-panel{position:fixed;inset:0;background:#0006;z-index:25;
  display:none;justify-content:flex-end}
.cart-panel.open{display:flex}
.cart-content{background:var(--paper);width:min(420px,100%);height:100%;
  padding:25px;overflow:auto}
.cart-head{display:flex;justify-content:space-between;align-items:center;
  border-bottom:1px solid var(--line);padding-bottom:18px}
.cart-head h3{font-family:var(--serif);font-weight:400;font-size:27px;margin:0}
.close-cart{border:0;background:transparent;font-size:25px}
.cart-items{padding:15px 0}
.cart-item{display:flex;justify-content:space-between;gap:12px;
  padding:14px 0;border-bottom:1px solid var(--line);font-size:12px}
.cart-item small{display:block;color:var(--muted);margin-top:6px}
.remove{border:0;background:transparent;color:var(--muted);font-size:11px}
.cart-total{display:flex;justify-content:space-between;padding:18px 0;
  border-top:1px solid var(--line);font-size:14px}
.checkout{width:100%;padding:15px;border:0;background:var(--green-dark);
  color:white;font-size:11px;letter-spacing:1px}
.cart-note{font-size:10px;line-height:1.7;color:var(--muted)}
@media(max-width:850px){
  .navlinks{gap:13px}
  .products{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 13px}
  .hero-inner{min-height:410px}
  .hero-copy{padding:28px}
  .story-image{min-height:350px}
}
@media(max-width:600px){
  .announcement{font-size:9px;letter-spacing:.7px}
  .nav{min-height:67px;padding:0 4%;gap:8px}
  .logo{font-size:24px;letter-spacing:3px}
  .logo small{font-size:7px;letter-spacing:2.5px}
  .navlinks{display:none}
  .navright{gap:6px}
  .lang{font-size:10px}
  .cart{padding:10px;font-size:10px}
  .hero{padding:14px 4% 30px}
  .hero-inner{grid-template-columns:1fr}
  .hero-copy{padding:38px 25px}
  h1{font-size:52px;margin:17px 0}
  .hero-copy p{font-size:13px}
  .hero-image{min-height:300px}
  .benefits{gap:8px;padding:20px 3%}
  .benefits div{font-size:9px}
  .benefits span{font-size:9px;line-height:1.5}
  .section{padding:52px 4%}
  .section-head{display:block}
  .section-head p{margin-top:10px}
  .products{gap:19px 11px}
  .product-title{font-size:17px}
  .product-desc{font-size:10px}
  .tag{font-size:8px;top:8px;left:8px}
  .quick-add{left:6px;right:6px;bottom:6px;width:calc(100% - 12px);
    padding:12px 2px;font-size:9px}
  .story{grid-template-columns:1fr}
  .story-image{min-height:290px}
  .story-copy{padding:35px 25px}
  .newsletter{padding:48px 18px}
  .footer-inner{align-items:flex-start;flex-direction:column}
}
</style>
</head>
