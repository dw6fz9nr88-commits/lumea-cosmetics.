let lang="pl", filter="all", cart=[];
const money=n=>new Intl.NumberFormat(lang==="pl"?"pl-PL":lang==="ru"?"ru-RU":"en-GB",{style:"currency",currency:"PLN"}).format(n);
const tr=k=>translations[lang][k]||translations.pl[k];
function renderProducts(){
 const list=products.filter(p=>filter==="all"||p.cat===filter);
 document.getElementById("products").innerHTML=list.map(p=>`
 <article class="product">
  <div class="product-photo">
   <img src="https://images.unsplash.com/${p.image}?auto=format&fit=crop&w=700&q=80" alt="${p.name[lang]}" loading="lazy">
   <span class="tag">${p.tag[lang]}</span>
   <button class="quick-add" data-add="${p.id}">${tr("add")} +</button>
  </div>
  <div class="product-info">
   <div class="product-type">${p.type[lang]}</div>
   <div class="product-title">${p.name[lang]}</div>
   <div class="product-desc">${p.desc[lang]}</div>
   <div class="price-row"><strong>${money(p.price)}</strong><span class="stars">★★★★★</span></div>
  </div>
 </article>`).join("");
}
function renderCart(){
 const items=document.getElementById("cart-items");
 document.getElementById("cart-count").textContent=cart.reduce((n,p)=>n+p.qty,0);
 if(!cart.length)items.innerHTML=`<p>${tr("empty")}</p>`;
 else items.innerHTML=cart.map(p=>`<div class="cart-item"><div><strong>${p.name[lang]}</strong><small>${money(p.price)} × ${p.qty}</small></div><button class="remove" data-remove="${p.id}">${tr("remove")}</button></div>`).join("");
 document.getElementById("cart-total").textContent=money(cart.reduce((n,p)=>n+p.price*p.qty,0));
}
function showToast(text){
 const t=document.getElementById("toast");t.textContent=text;t.classList.add("show");
 setTimeout(()=>t.classList.remove("show"),1800);
}
function setLanguage(value){
 lang=value;document.documentElement.lang=lang;
 document.querySelectorAll("[data-i18n]").forEach(el=>{
  const key=el.dataset.i18n;
  if(translations[lang][key])el.innerHTML=translations[lang][key];
 });
 document.getElementById("email").placeholder=tr("email");
 document.getElementById("open-cart").innerHTML=`${lang==="pl"?"TORBA":lang==="ru"?"КОРЗИНА":"BAG"} (<span id="cart-count">0</span>)`;
 document.querySelectorAll(".filter").forEach(b=>{
  const keys={all:"filterAll",face:"filterFace",body:"filterBody",sets:"filterSets"};
  b.textContent=tr(keys[b.dataset.filter]);
 });
 renderProducts();renderCart();
}
document.getElementById("language").addEventListener("change",e=>setLanguage(e.target.value));
document.querySelector(".filters").addEventListener("click",e=>{
 const b=e.target.closest("[data-filter]");if(!b)return;
 filter=b.dataset.filter;
 document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));
 renderProducts();
});
document.getElementById("products").addEventListener("click",e=>{
 const b=e.target.closest("[data-add]");if(!b)return;
 const p=products.find(x=>x.id===Number(b.dataset.add));
 const existing=cart.find(x=>x.id===p.id);
 if(existing)existing.qty++;else cart.push({...p,qty:1});
 renderCart();showToast(`${p.name[lang]} — ${tr("added").toLowerCase()}`);
});
document.getElementById("cart-items").addEventListener("click",e=>{
 const b=e.target.closest("[data-remove]");if(!b)return;
 cart=cart.filter(p=>p.id!==Number(b.dataset.remove));renderCart();
});
const panel=document.getElementById("cart-panel");
document.getElementById("open-cart").addEventListener("click",()=>{
 renderCart();panel.classList.add("open");panel.setAttribute("aria-hidden","false");
});
function closeCart(){panel.classList.remove("open");panel.setAttribute("aria-hidden","true")}
document.getElementById("close-cart").addEventListener("click",closeCart);
panel.addEventListener("click",e=>{if(e.target===panel)closeCart()});
document.getElementById("checkout").addEventListener("click",()=>showToast(tr("checkoutMessage")));
document.getElementById("newsletter-form").addEventListener("submit",e=>{
 e.preventDefault();document.getElementById("newsletter-message").textContent=tr("newsletterMessage");
 document.getElementById("email").value="";
});
document.getElementById("year").textContent=new Date().getFullYear();
setLanguage("pl");
</script>
